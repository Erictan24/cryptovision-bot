# ============================================================
# .env.example — TEMPLATE konfigurasi CryptoVision Bot
# ============================================================
# Copy file ini jadi `.env` lalu isi nilai aslinya:
#     cp .env.example .env
# JANGAN commit file `.env` (sudah masuk .gitignore).
# Semua nilai di bawah cuma PLACEHOLDER — ganti dengan punyamu sendiri.
# ============================================================

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:GANTI_DENGAN_TOKEN_BOT_TELEGRAM_KAMU
ADMIN_TELEGRAM_ID=123456789          # Telegram user ID admin (angka)

# ── Bitunix Futures (TRADING — uang asli kalau PAPER_TRADING=0) ──
BITUNIX_API_KEY=ganti_dengan_api_key_bitunix
BITUNIX_SECRET_KEY=ganti_dengan_secret_key_bitunix

# ── Data provider (harga fallback) ──────────────────────────
CRYPTOCOMPARE_API_KEY=ganti_dengan_api_key_cryptocompare

# ── AI scoring (opsional — Anthropic) ───────────────────────
ANTHROPIC_API_KEY=                   # kosongkan kalau tidak pakai AI scoring

# ── Mode trading ────────────────────────────────────────────
PAPER_TRADING=1                      # 1 = uang palsu (paper), 0 = uang asli
TRADE_ENABLED=true                   # master switch auto-trade

# ── Money management ────────────────────────────────────────
TRADE_RISK_USD=1                     # nominal risk per trade (USD)
TRADE_RISK_PER_TRADE=2.0             # fallback % balance kalau RISK_USD=0
TRADE_LEVERAGE=10
TRADE_MAX_POSITIONS=99999            # Aggressive Mode = unlimited
TRADE_MAX_DAILY_LOSS=10.0            # batas loss harian (%)
TRADE_MAX_DAILY_LOSS_USD=99999       # batas loss harian (USD)
TRADE_SCAN_LIMIT=500                 # jumlah coin di-scan (Bitunix top-N)
TRADE_MAX_PER_CYCLE=99999            # max trade per cycle scan
TRADE_CIRCUIT_BREAKER=2              # SL beruntun → pause
TRADE_PAUSE_HOURS=4                  # durasi pause circuit breaker

# ── Web dashboard (opsional) ────────────────────────────────
WEB_URL=https://cryptovision-web.vercel.app
# WEB_HMAC_SECRET=...                # secret HMAC bot→web (kalau pakai web push)
